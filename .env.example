# 服务只监听本机；这里不要改成 0.0.0.0。
CONTRACT_CONSOLE_HOST=127.0.0.1
CONTRACT_CONSOLE_PORT=4174

# 可选：签名私钥。为空时要求 RPC 节点已解锁页面填写的 Admin 地址。
# CONTRACT_CONSOLE_PRIVATE_KEY=0x...

# 子进程运行上限（毫秒）
CONTRACT_CONSOLE_JOB_TIMEOUT_MS=600000

# 待部署合约超过 EIP-170 的 24 KB 标准上限时使用此开关。
# 仅当目标 Besu 已明确允许超大合约时才能设为 true；默认拒绝发送交易。
CONTRACT_CONSOLE_ALLOW_OVERSIZED_CONTRACTS=false
