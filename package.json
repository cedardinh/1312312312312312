{
  "name": "contract-console",
  "version": "1.0.0",
  "private": true,
  "description": "Offline deployment and UUPS upgrade console for existing EVM networks",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/src/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "@openzeppelin/contracts-upgradeable": "5.0.2",
    "@nomicfoundation/hardhat-ethers": "3.1.2",
    "@openzeppelin/hardhat-upgrades": "3.9.1",
    "dotenv": "17.2.2",
    "ethers": "6.17.0",
    "express": "5.2.1",
    "hardhat": "2.28.6",
    "helmet": "8.1.0",
    "multer": "2.2.0",
    "pino-http": "10.5.0",
    "solc": "0.8.24",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/multer": "1.4.13",
    "@types/node": "22.18.3",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2",
    "vite": "7.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
